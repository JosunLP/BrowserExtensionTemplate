{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "outDir": "./tools/",
    "rootDir": "./tools/",
    "removeComments": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "chrome"]
  },
  "include": ["./tools/*.ts"],
  "exclude": ["node_modules", "./src/*.ts", "./src/**/*.ts", "./dist/*.ts", "./dist/*.js"]
}
